{
  "name": "recomp-harness-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents discover, build, recompile, and run the static-recompilation harnesses in the recomp collection.",
  "type": "module",
  "bin": {
    "recomp-harness-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "scan": "tsc -p tsconfig.json && node dist/cli-scan.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "static-recompilation",
    "decompilation",
    "emulation",
    "retro"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
